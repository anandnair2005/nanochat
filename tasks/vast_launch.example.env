# Copy relevant values into local .env and replace placeholders.
# This file is an example only and must not contain real secrets.

NANOCHAT_RUN_ID="d24"
NANOCHAT_IMAGE="anandnair2005/nanochat-vast:h100"
NANOCHAT_BASE_DIR="/workspace/nanochat-cache"
NANOCHAT_RCLONE_REMOTE="nanochat_gdrive_runner:"
NANOCHAT_NUM_GPUS="4"
NANOCHAT_DEVICE_BATCH_SIZE="16"
NANOCHAT_ENABLE_FP8="1"
NANOCHAT_DEPTH="24"
NANOCHAT_TARGET_PARAM_DATA_RATIO="8"
NANOCHAT_DATASET_SHARDS="170"
NANOCHAT_BASE_SAVE_EVERY="200"
NANOCHAT_RETAIN_CHECKPOINTS="3"

# Local file paths. Store paths only, not key contents.
NANOCHAT_SSH_PUBLIC_KEY_FILE="/path/to/id_ed25519.pub"
NANOCHAT_SSH_PRIVATE_KEY_FILE="/path/to/id_ed25519"
NANOCHAT_SSH_USER="root"

# Optional local override for rclone config location.
NANOCHAT_RCLONE_CONFIG_FILE="/path/to/rclone.conf"

# Export this in your shell for H100 launch. Do not commit it.
WANDB_API_KEY="<set-in-local-shell-not-in-this-file>"

# Vast API key should remain in Vast CLI config or local environment only.
VAST_API_KEY="<set-in-local-shell-or-vast-cli-config>"
